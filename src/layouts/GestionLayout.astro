---
import Base from "./Base.astro";
import "../styles/gestion.css";
import { PAGINAS_GESTION, tienePermiso } from "../lib/auth/roles";

interface Props {
  title: string;
  activo:
    | "index"
    | "veedores"
    | "coordinadores"
    | "acreditados-cda"
    | "militancia"
    | "lideres"
    | "lista-negra"
    | "cobertura"
    | "crecimiento"
    | "organigrama"
    | "estructura"
    | "accesos";
}

const { title, activo } = Astro.props;
const rol = Astro.locals.rol;

const GROUP_LABEL: Record<string, string> = {
  gestion: "Gestión",
  reportes: "Reportes",
  admin: "Administración",
};

const links = [
  { href: "/gestion", key: "index", label: "Resumen", group: "gestion" },
  {
    href: "/gestion/veedores",
    key: "veedores",
    label: "Veedores",
    group: "gestion",
  },
  {
    href: "/gestion/coordinadores",
    key: "coordinadores",
    label: "Coordinadores",
    group: "gestion",
  },
  {
    href: "/gestion/acreditados-cda",
    key: "acreditados-cda",
    label: "Acreditados CDA",
    group: "gestion",
  },
  {
    href: "/gestion/militancia",
    key: "militancia",
    label: "Militancia",
    group: "gestion",
  },
  {
    href: "/gestion/lideres",
    key: "lideres",
    label: "Líderes",
    group: "gestion",
  },
  {
    href: "/gestion/lista-negra",
    key: "lista-negra",
    label: "Lista negra",
    group: "gestion",
  },
  {
    href: "/gestion/cobertura",
    key: "cobertura",
    label: "Cobertura",
    group: "reportes",
  },
  {
    href: "/gestion/crecimiento",
    key: "crecimiento",
    label: "Crecimiento",
    group: "reportes",
  },
  {
    href: "/gestion/organigrama",
    key: "organigrama",
    label: "Organigrama",
    group: "reportes",
  },
  {
    href: "/gestion/estructura",
    key: "estructura",
    label: "Estructura organizativa",
    group: "reportes",
  },
  { href: "/gestion/accesos", key: "accesos", label: "Accesos", group: "admin" },
].filter((l) => tienePermiso(rol, PAGINAS_GESTION[l.key]));

const principal = links.find((l) => l.key === "index") ?? null;
const resto = links.filter((l) => l.key !== "index");
---

<Base title={`${title} · Gestión`}>
  <div class="g-shell-wrap">
    <header class="g-topbar">
      <a class="g-topbar-back" href="/">‹ Mapa</a>
      <span class="g-topbar-title">{title}</span>
      <input
        type="checkbox"
        id="g-nav-check"
        class="g-nav-toggle"
        aria-label="Abrir menú"
      />
    </header>
    <label for="g-nav-check" class="g-nav-backdrop" aria-hidden="true"></label>
    <div class="g-shell">
      <nav class="g-sidebar" aria-label="Menú de gestión">
        <a class="g-sidebar-back" href="/">‹ Volver al mapa</a>
        <div class="g-sidebar-links">
          {principal ? (
            <a
              href={principal.href}
              class="g-sidebar-link"
              aria-current={activo === principal.key ? "page" : undefined}
            >
              {principal.label}
            </a>
          ) : null}
          {resto.map((l, i) => (
            <>
              {i === 0 || l.group !== resto[i - 1].group ? (
                <p class="g-sidebar-group-label">{GROUP_LABEL[l.group]}</p>
              ) : null}
              <a
                href={l.href}
                class="g-sidebar-link"
                aria-current={activo === l.key ? "page" : undefined}
              >
                {l.label}
              </a>
            </>
          ))}
        </div>
        {rol !== "invitado" ? (
          <form
            class="g-sidebar-footer"
            method="POST"
            action={
              rol === "administrador"
                ? "/api/admin/logout"
                : "/api/acceso/salir"
            }
          >
            <button type="submit" class="g-sidebar-salir">
              Cerrar sesión
            </button>
          </form>
        ) : null}
      </nav>
      <main class="g-main">
        <slot />
      </main>
    </div>
  </div>
</Base>
