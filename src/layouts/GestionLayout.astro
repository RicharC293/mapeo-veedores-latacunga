---
import Base from "./Base.astro";
import "../styles/gestion.css";
import { PAGINAS_GESTION, tienePermiso } from "../lib/auth/roles";

interface Props {
  title: string;
  activo:
    | "index"
    | "veedores"
    | "coordinadores"
    | "acreditados-cda"
    | "lideres"
    | "lista-negra"
    | "cobertura"
    | "crecimiento"
    | "organigrama"
    | "accesos";
}

const { title, activo } = Astro.props;
const rol = Astro.locals.rol;

const links = [
  { href: "/gestion", key: "index", label: "Resumen" },
  { href: "/gestion/veedores", key: "veedores", label: "Veedores" },
  {
    href: "/gestion/coordinadores",
    key: "coordinadores",
    label: "Coordinadores",
  },
  {
    href: "/gestion/acreditados-cda",
    key: "acreditados-cda",
    label: "Acreditados CDA",
  },
  { href: "/gestion/lideres", key: "lideres", label: "Líderes" },
  { href: "/gestion/lista-negra", key: "lista-negra", label: "Lista negra" },
  { href: "/gestion/cobertura", key: "cobertura", label: "Cobertura" },
  { href: "/gestion/crecimiento", key: "crecimiento", label: "Crecimiento" },
  { href: "/gestion/organigrama", key: "organigrama", label: "Organigrama" },
  { href: "/gestion/accesos", key: "accesos", label: "Accesos" },
].filter((l) => tienePermiso(rol, PAGINAS_GESTION[l.key]));
---

<Base title={`${title} · Gestión`}>
  <div class="g-shell">
    <nav class="g-nav">
      <a class="g-nav-back" href="/">
        ‹ Mapa
      </a>
      {links.map((l) => (
        <a href={l.href} aria-current={activo === l.key ? "page" : undefined}>
          {l.label}
        </a>
      ))}
      {rol !== "invitado" ? (
        <form
          method="POST"
          action={rol === "administrador" ? "/api/admin/logout" : "/api/acceso/salir"}
          style="margin-left: auto;"
        >
          <button type="submit" class="g-nav-salir">Cerrar sesión</button>
        </form>
      ) : null}
    </nav>
    <slot />
  </div>
</Base>
