---
import GestionLayout from "../../layouts/GestionLayout.astro";
import GestionValidacion from "../../components/gestion/GestionValidacion";
import { getMapData } from "../../lib/data";
import { datosVerificacion } from "../../lib/validacion/pantalla";
import { PAGINAS_GESTION, rutaPorDefecto } from "../../lib/auth/roles";

if (!PAGINAS_GESTION.validacion.includes(Astro.locals.rol)) {
  return Astro.redirect(rutaPorDefecto(Astro.locals.rol));
}

const [data, datos] = await Promise.all([getMapData(), datosVerificacion()]);
const hayClave = Boolean(import.meta.env.ECUADORAPI_KEY);
---

<GestionLayout title="Verificación de identidad" activo="validacion">
  <h1>Verificación de identidad</h1>
  <p class="g-sub">
    Todas las personas del Consolidado (veedores, coordinadores y acreditados
    CDA) frente al Registro Civil. Filtra, selecciona las que faltan y
    consúltalas en bloque; luego revisa los nombres. Cada cédula se consulta una
    sola vez y se guarda la respuesta completa.
  </p>
  <GestionValidacion
    client:load
    parroquias={data.parroquias.features.map(({ properties }) => ({
      properties,
    }))}
    recintos={data.recintos}
    datosIniciales={datos}
    hayClave={hayClave}
  />
</GestionLayout>
