---
import GestionLayout from "../../layouts/GestionLayout.astro";
import GestionLideres from "../../components/gestion/GestionLideres";
import { getMapData } from "../../lib/data";
import { listLideres } from "../../lib/gestion/lideres";
import { PAGINAS_GESTION, rutaPorDefecto } from "../../lib/auth/roles";

if (!PAGINAS_GESTION.lideres.includes(Astro.locals.rol)) {
  return Astro.redirect(rutaPorDefecto(Astro.locals.rol));
}

const data = await getMapData();
const lideres = await listLideres();
---

<GestionLayout title="Líderes" activo="lideres">
  <h1>Líderes</h1>
  <p class="g-sub">
    Rol solo organizativo, sin injerencia en el proceso electoral. El cargo
    (dignidad) y el ámbito de liderazgo son independientes: una persona puede
    ser candidata sin liderar, o liderar sin ser candidata. Un líder de
    parroquia puede tener a su cargo una o varias parroquias; el líder general
    coordina todo el cantón. Las personas no entran a la lista negra al ser
    removidas.
  </p>
  <GestionLideres
    client:load
    parroquias={data.parroquias.features}
    recintos={data.recintos}
    lideresIniciales={lideres}
  />
</GestionLayout>
