---
import GestionLayout from "../../layouts/GestionLayout.astro";
import GestionCoordinadores from "../../components/gestion/GestionCoordinadores";
import { getMapData } from "../../lib/data";
import { listCoordinadores } from "../../lib/gestion/coordinadores";
import { listLideres } from "../../lib/gestion/lideres";
import { PAGINAS_GESTION, rutaPorDefecto } from "../../lib/auth/roles";

if (!PAGINAS_GESTION.coordinadores.includes(Astro.locals.rol)) {
  return Astro.redirect(rutaPorDefecto(Astro.locals.rol));
}

const data = await getMapData();
const coordinadores = await listCoordinadores();
const lideres = await listLideres();
---

<GestionLayout title="Coordinadores" activo="coordinadores">
  <h1>Coordinadores de recinto</h1>
  <p class="g-sub">
    Todos los recintos del cantón agrupados por parroquia, cada uno con su
    coordinador titular y sus suplentes. Filtra por tipo de parroquia (urbanas o
    rurales), por parroquia o por si ya tienen coordinador.
  </p>
  <GestionCoordinadores
    client:load
    parroquias={data.parroquias.features.map(({ properties }) => ({
      properties,
    }))}
    recintos={data.recintos}
    lideres={lideres}
    coordinadoresIniciales={coordinadores}
  />
</GestionLayout>
