---
import GestionLayout from "../../layouts/GestionLayout.astro";
import GestionMilitancia from "../../components/gestion/GestionMilitancia";
import { getMapData } from "../../lib/data";
import { listMilitantes } from "../../lib/gestion/militancia";
import { listLideres } from "../../lib/gestion/lideres";
import { PAGINAS_GESTION, rutaPorDefecto } from "../../lib/auth/roles";

if (!PAGINAS_GESTION.militancia.includes(Astro.locals.rol)) {
  return Astro.redirect(rutaPorDefecto(Astro.locals.rol));
}

const data = await getMapData();
const militantes = await listMilitantes();
const lideres = await listLideres();
---

<GestionLayout title="Militancia" activo="militancia">
  <h1>Militancia</h1>
  <p class="g-sub">
    Carga personas una por una o en bloque y asígnalas después como veedor,
    coordinador o acreditado CDA. Si traen un recinto de preferencia, se
    precarga la asignación cuando es inequívoco.
  </p>
  <GestionMilitancia
    client:load
    parroquias={data.parroquias.features}
    recintos={data.recintos}
    lideres={lideres}
    militantesIniciales={militantes}
  />
</GestionLayout>
