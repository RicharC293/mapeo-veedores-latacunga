---
import GestionLayout from "../../layouts/GestionLayout.astro";
import InformeAcciones from "../../components/gestion/InformeAcciones";
import { getMapData } from "../../lib/data";
import { listVeedores } from "../../lib/gestion/veedores";
import { listCoordinadores } from "../../lib/gestion/coordinadores";
import { listAcreditadosCda } from "../../lib/gestion/acreditadosCda";
import {
  agruparPorRecinto,
  filasListado,
  type Dignidad,
  type FilaListado,
} from "../../lib/gestion/listado";
import { listValidaciones } from "../../lib/validacion/validaciones";
import {
  datosPersonales,
  edad,
  MAYORIA_DE_EDAD,
  type ValidacionCedula,
} from "../../lib/validacion/plan";
import { fmt, title } from "../../lib/format";
import { PAGINAS_GESTION, rutaPorDefecto } from "../../lib/auth/roles";

// Trae cédulas y celulares: el mismo permiso que Descargas.
if (!PAGINAS_GESTION.descargas.includes(Astro.locals.rol)) {
  return Astro.redirect(rutaPorDefecto(Astro.locals.rol));
}

const [mapa, veedores, coordinadores, acreditados] = await Promise.all([
  getMapData(),
  listVeedores(),
  listCoordinadores(),
  listAcreditadosCda(),
]);

// Cada recinto en su hoja, con sus personas separadas por dignidad y, los
// veedores, por junta. Los puestos titulares sin cubrir van como filas
// vacías, para anotar a mano a quien se consiga.
const filas = filasListado({
  recintos: mapa.recintos,
  parroquias: mapa.parroquias.features.map(({ properties }) => ({
    properties,
  })),
  veedores,
  coordinadores,
  acreditados,
  conPorCubrir: true,
});
// Los menores de edad no pueden cubrir el puesto: van en rojo, para
// reemplazarlos. La edad sale de la validación con el Registro Civil; si la
// tabla de validaciones no existe, no se marca a nadie.
async function cargarValidaciones(): Promise<ValidacionCedula[]> {
  try {
    return await listValidaciones();
  } catch {
    return [];
  }
}
const validacionDe = new Map(
  (await cargarValidaciones()).map((v) => [v.cedula, v]),
);
const hoy = new Date();
const edadDe = (f: FilaListado) =>
  f.porCubrir
    ? null
    : edad(datosPersonales(validacionDe.get(f.cedula)).fechaNacimiento, hoy);
const esMenor = (f: FilaListado) => {
  const e = edadDe(f);
  return e !== null && e < MAYORIA_DE_EDAD;
};
const menores = (lista: FilaListado[]) => lista.filter(esMenor).length;
const LEYENDA = "En rojo: menor de edad, hay que reemplazarlo.";

const recintos = agruparPorRecinto(filas).map((r) => ({
  ...r,
  dignidades: (["Coordinador", "Acreditado CDA", "Veedor"] as Dignidad[])
    .map((d) => ({
      dignidad: d,
      filas: r.filas.filter((f) => f.dignidad === d),
    }))
    .filter((d) => d.filas.length > 0),
}));
const PLURAL: Record<Dignidad, string> = {
  Coordinador: "Coordinadores",
  "Acreditado CDA": "Acreditados CDA",
  Veedor: "Veedores",
};
const personas = (n: number) => `${fmt(n)} ${n === 1 ? "persona" : "personas"}`;
const resumen = (lista: FilaListado[]) => {
  const faltan = lista.filter((f) => f.porCubrir).length;
  const hay = lista.length - faltan;
  const partes = [
    hay > 0 || faltan === 0 ? personas(hay) : "",
    faltan > 0 ? `${fmt(faltan)} por cubrir` : "",
  ];
  const n = menores(lista);
  if (n > 0) {
    partes.push(`${fmt(n)} ${n === 1 ? "menor" : "menores"} de edad`);
  }
  return partes.filter(Boolean).join(" · ");
};
const tipo = (f: FilaListado) =>
  f.porCubrir ? "Por cubrir" : f.tipo === "titular" ? "Titular" : "Suplente";

const corte = new Intl.DateTimeFormat("es-EC", {
  dateStyle: "long",
  timeStyle: "short",
  timeZone: "America/Guayaquil",
}).format(new Date());
const fechaArchivo = new Date().toISOString().slice(0, 10);
---

<GestionLayout title="Listado general" activo="descargas">
  <article class="g-informe g-listado g-listado-general">
    <header class="g-informe-cabecera">
      <div>
        <h1>Listado general</h1>
        <p class="g-informe-corte">
          {`${fmt(recintos.length)} recintos · ${resumen(filas)} · datos al ${corte} (hora de Ecuador)`}
        </p>
        {menores(filas) > 0 ? (
          <p class="g-listado-leyenda">{LEYENDA}</p>
        ) : null}
      </div>
      <InformeAcciones
        client:load
        encabezados={[
          "Tipo de parroquia",
          "Parroquia",
          "Recinto",
          "Dignidad",
          "Junta",
          "Titular o suplente",
          "Cédula",
          "Nombres",
          "Teléfono",
          "Observación",
        ]}
        filas={recintos.flatMap((r) =>
          r.filas.map((f) => [
            f.urbana ? "Urbana" : "Rural",
            f.parroquia,
            title(f.recinto),
            f.dignidad,
            f.junta ?? "",
            tipo(f),
            f.cedula,
            f.nombres,
            f.telefono,
            esMenor(f) ? `Menor de edad (${edadDe(f)} años)` : "",
          ]),
        )}
        nombreArchivo={`listado-general-latacunga-${fechaArchivo}.csv`}
      />
    </header>

    {recintos.map((r) => (
      <section class="g-listado-recinto">
        <h2>
          {title(r.recinto)}
          <span class="g-listado-recinto-dato">
            {`Parroquia ${r.parroquia} (${r.urbana ? "urbana" : "rural"}) · ${resumen(r.filas)}`}
          </span>
        </h2>
        {menores(r.filas) > 0 ? (
          <p class="g-listado-leyenda">{LEYENDA}</p>
        ) : null}
        <div class="g-table-scroll">
          <table class="g-table g-informe-tabla g-listado-tabla">
            <caption class="g-sr-only">Personas de {title(r.recinto)}</caption>
            <thead>
              <tr>
                <th scope="col">Junta</th>
                <th scope="col">Cédula</th>
                <th scope="col">Nombres</th>
                <th scope="col">Teléfono</th>
                <th scope="col">Tipo</th>
              </tr>
            </thead>
            {r.dignidades.map((d) => (
              <tbody>
                <tr class="g-informe-grupo">
                  <th scope="colgroup" colspan="5">
                    {`${PLURAL[d.dignidad]} · ${resumen(d.filas)}`}
                  </th>
                </tr>
                {d.filas.map((f) => (
                  <tr
                    class:list={{
                      "g-listado-vacio": f.porCubrir,
                      "g-listado-menor": esMenor(f),
                    }}
                    title={
                      esMenor(f) ? `Menor de edad (${edadDe(f)} años)` : undefined
                    }
                  >
                    <td class="g-listado-dato">{f.junta ?? "—"}</td>
                    <td class="g-listado-dato">{f.cedula}</td>
                    <td>{f.nombres}</td>
                    <td class="g-listado-dato">{f.telefono}</td>
                    <td>{tipo(f)}</td>
                  </tr>
                ))}
              </tbody>
            ))}
          </table>
        </div>
      </section>
    ))}
  </article>
</GestionLayout>
