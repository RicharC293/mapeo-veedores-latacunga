---
import GestionLayout from "../../layouts/GestionLayout.astro";
import InformeAcciones from "../../components/gestion/InformeAcciones";
import TablaCifras from "../../components/gestion/TablaCifras.astro";
import { getMapData } from "../../lib/data";
import { listVeedores } from "../../lib/gestion/veedores";
import { listCoordinadores } from "../../lib/gestion/coordinadores";
import { listAcreditadosCda } from "../../lib/gestion/acreditadosCda";
import { listMilitantes } from "../../lib/gestion/militancia";
import { armarInforme } from "../../lib/gestion/informe";
import { fmt, title } from "../../lib/format";
import { PAGINAS_GESTION, rutaPorDefecto } from "../../lib/auth/roles";

if (!PAGINAS_GESTION.informe.includes(Astro.locals.rol)) {
  return Astro.redirect(rutaPorDefecto(Astro.locals.rol));
}
// Las cifras de Militancia (personas pendientes de asignar) son de trabajo
// interno: el militante ve el informe sin esa parte.
const veOperacion = Astro.locals.rol !== "militante";

const [data, veedores, coordinadores, acreditados, militantes] =
  await Promise.all([
    getMapData(),
    listVeedores(),
    listCoordinadores(),
    listAcreditadosCda(),
    veOperacion ? listMilitantes() : Promise.resolve([]),
  ]);

const informe = armarInforme({
  recintos: data.recintos,
  parroquias: data.parroquias.features.map(({ properties }) => ({
    properties,
  })),
  veedores,
  coordinadores,
  acreditados,
  militantes,
  ahora: Date.now(),
});

const pctTxt = (n: number) =>
  `${n.toLocaleString("es-EC", { maximumFractionDigits: 1 })} %`;
const corte = new Intl.DateTimeFormat("es-EC", {
  dateStyle: "long",
  timeStyle: "short",
  timeZone: "America/Guayaquil",
}).format(new Date(informe.corte));
const fechaArchivo = new Date(informe.corte).toISOString().slice(0, 10);

const { cobertura, ritmo, acciones, total, militancia } = informe;

const primeras = acciones.slice(0, 5);
const desbloqueanPrimeras = primeras.reduce((a, x) => a + x.desbloquea, 0);
const pctConPrimeras =
  primeras.length > 0 ? primeras[primeras.length - 1].pctAcumulado : null;
const filasAcciones = acciones.slice(0, 10);
const filasVeedores = informe.accionesVeedores.slice(0, 10);
const juntasPorVeedores = informe.accionesVeedores.reduce(
  (a, x) => a + x.sinVeedor,
  0,
);

// Resumen por zona: los mismos cuatro renglones para urbano, rural y cantón.
const etiquetasRol = {
  veedores: "Veedores",
  coordinadores: "Coordinadores",
  cda: "Acreditados CDA",
  completa: "Juntas con cobertura completa",
} as const;
const zonas = [
  { nombre: "Urbano", cifras: informe.subtotalUrbanas },
  { nombre: "Rural", cifras: informe.subtotalRurales },
  { nombre: "Cantón", cifras: total },
];

const etiquetaEstado = {
  completo: "Completo",
  casi: "Casi completo",
  pendiente: "Con pendientes",
} as const;
const si = (v: number) => (v > 0 ? "Sí" : "No");

const csvEncabezados = [
  "Parroquia",
  "Tipo de parroquia",
  "Recinto",
  "Juntas (veedores requeridos)",
  "Veedores ingresados",
  "Veedores verificados",
  "Veedores que faltan",
  "Coordinador ingresado",
  "Coordinador verificado",
  "Recinto CDA",
  "Acreditado CDA ingresado",
  "Acreditado CDA verificado",
  "Juntas con cobertura completa",
  "% cobertura completa",
  "Estado del recinto",
];
const csvFilas = informe.detalle.map((d) => [
  d.parroquia,
  d.urbana ? "Urbana" : "Rural",
  title(d.recinto),
  d.veedores.requerido,
  d.veedores.ingresados,
  d.veedores.verificados,
  d.veedores.faltan,
  si(d.coordinadores.ingresados),
  si(d.coordinadores.verificados),
  si(d.cda.requerido),
  d.cda.requerido > 0 ? si(d.cda.ingresados) : "",
  d.cda.requerido > 0 ? si(d.cda.verificados) : "",
  d.completa.ingresados,
  d.completa.pct,
  etiquetaEstado[d.estado],
]);

const secciones = [
  {
    rol: "veedores",
    titulo: "Veedores",
    nota: "Un veedor titular por junta receptora del voto.",
  },
  {
    rol: "coordinadores",
    titulo: "Coordinadores",
    nota: "Un coordinador titular por recinto electoral.",
  },
  {
    rol: "cda",
    titulo: "Acreditados CDA",
    nota: "Un acreditado titular por recinto CDA.",
  },
] as const;
---

<GestionLayout title="Informe de cobertura" activo="informe">
  <article class="g-informe">
    <header class="g-informe-cabecera">
      <div>
        <h1>Informe de cobertura</h1>
        <p class="g-informe-corte">
          Cantón Latacunga · datos al {corte} (hora de Ecuador)
        </p>
      </div>
      <InformeAcciones
        client:load
        encabezados={csvEncabezados}
        filas={csvFilas}
        nombreArchivo={`cobertura-latacunga-${fechaArchivo}.csv`}
      />
    </header>

    <section aria-labelledby="inf-resumen">
      <h2 id="inf-resumen">Resumen</h2>
      <p class="g-informe-lead">
        Hoy{" "}
        <strong>
          {fmt(cobertura.cubiertas)} de {fmt(informe.totales.juntas)} juntas (
          {pctTxt(cobertura.pct)})
        </strong>{" "}
        tienen cobertura completa: cuentan con veedor titular y su recinto tiene
        coordinador titular.
      </p>
      <div class="g-table-scroll">
        <table class="g-table g-informe-tabla">
          <caption class="g-sr-only">
            Avance por rol, urbano, rural y cantón
          </caption>
          <thead>
            <tr>
              <th>Rol</th>
              <th class="g-num">Requerido</th>
              <th class="g-num">Ingresados</th>
              <th class="g-num">Verificados</th>
              <th class="g-num">Faltan</th>
              <th class="g-num">% Cobertura</th>
              <th class="g-num">% Faltante</th>
            </tr>
          </thead>
          {zonas.map((z) => (
            <tbody>
              <tr class="g-informe-grupo">
                <th scope="colgroup" colspan="7">
                  {z.nombre}
                </th>
              </tr>
              {(["veedores", "coordinadores", "cda", "completa"] as const).map(
                (r) => (
                  <tr
                    class={r === "completa" ? "g-informe-destacada" : undefined}
                  >
                    <td>{etiquetasRol[r]}</td>
                    <td class="g-num">{fmt(z.cifras[r].requerido)}</td>
                    <td class="g-num">{fmt(z.cifras[r].ingresados)}</td>
                    <td class="g-num">{fmt(z.cifras[r].verificados)}</td>
                    <td class="g-num">{fmt(z.cifras[r].faltan)}</td>
                    <td class="g-num">{pctTxt(z.cifras[r].pct)}</td>
                    <td class="g-num">{pctTxt(z.cifras[r].pctFaltante)}</td>
                  </tr>
                ),
              )}
            </tbody>
          ))}
        </table>
      </div>
      <p class="g-informe-pie">
        Requerido: una junta, un recinto y un recinto CDA tienen cada uno un
        puesto de titular. Los suplentes no cuentan. Verificados: ya fueron
        contactados.
      </p>
    </section>

    {secciones.map((sec) => (
      <section aria-labelledby={`inf-${sec.rol}`}>
        <h2 id={`inf-${sec.rol}`}>{sec.titulo}</h2>
        <p class="g-informe-lead">
          {sec.nota} Hay{" "}
          <strong>
            {fmt(total[sec.rol].ingresados)} de {fmt(total[sec.rol].requerido)}
          </strong>{" "}
          ingresados ({pctTxt(total[sec.rol].pct)}); faltan{" "}
          <strong>{fmt(total[sec.rol].faltan)}</strong>.
        </p>
        <TablaCifras
          rol={sec.rol}
          urbanas={informe.urbanas}
          rurales={informe.rurales}
          subtotalUrbanas={informe.subtotalUrbanas}
          subtotalRurales={informe.subtotalRurales}
        />
      </section>
    ))}

    <section aria-labelledby="inf-acciones">
      <h2 id="inf-acciones">Dónde actuar primero</h2>
      {acciones.length === 0 ? (
        <p class="g-informe-lead">
          Todos los recintos con veedores ya tienen coordinador titular.
        </p>
      ) : (
        <>
          <p class="g-informe-lead">
            Asignar coordinador a los primeros{" "}
            <strong>{primeras.length}</strong>{" "}
            {primeras.length === 1 ? "recinto" : "recintos"} de esta lista
            sumaría <strong>{fmt(desbloqueanPrimeras)} juntas</strong> y
            llevaría la cobertura completa de {pctTxt(cobertura.pct)} a{" "}
            <strong>{pctTxt(pctConPrimeras ?? cobertura.pct)}</strong>.
          </p>
          <div class="g-table-scroll">
            <table class="g-table g-informe-tabla">
              <caption class="g-sr-only">
                Recintos con veedores y sin coordinador, ordenados por las
                juntas que se sumarían
              </caption>
              <thead>
                <tr>
                  <th class="g-num">N.º</th>
                  <th>Recinto</th>
                  <th>Parroquia</th>
                  <th class="g-num">Juntas con veedor</th>
                  <th class="g-num">Se suman</th>
                  <th class="g-num">Cobertura acumulada</th>
                </tr>
              </thead>
              <tbody>
                {filasAcciones.map((a, i) => (
                  <tr>
                    <td class="g-num">{i + 1}</td>
                    <td>{title(a.recinto)}</td>
                    <td>{a.parroquia}</td>
                    <td class="g-num">
                      {a.desbloquea} de {a.totalJuntas}
                    </td>
                    <td class="g-num">+{a.desbloquea}</td>
                    <td class="g-num">{pctTxt(a.pctAcumulado)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="g-informe-pie">
            {acciones.length > filasAcciones.length
              ? `Se muestran los ${filasAcciones.length} primeros de ${acciones.length} recintos; la lista completa está en el CSV. `
              : ""}
            {total.cda.faltan > 0
              ? `Además, ${total.cda.faltan} de los ${total.cda.requerido} recintos CDA no tienen acreditado titular.`
              : ""}
          </p>
        </>
      )}
      {filasVeedores.length > 0 ? (
        <>
          <h3 class="g-informe-subtitulo">
            Dónde faltan veedores (recintos que ya tienen coordinador)
          </h3>
          <p class="g-informe-lead">
            En estos {fmt(informe.accionesVeedores.length)} recintos cada veedor
            titular nuevo suma una junta cubierta de inmediato. En conjunto
            faltan <strong>{fmt(juntasPorVeedores)} veedores</strong>.
          </p>
          <div class="g-table-scroll">
            <table class="g-table g-informe-tabla">
              <caption class="g-sr-only">
                Recintos con coordinador y juntas sin veedor titular
              </caption>
              <thead>
                <tr>
                  <th class="g-num">N.º</th>
                  <th>Recinto</th>
                  <th>Parroquia</th>
                  <th class="g-num">Juntas sin veedor</th>
                </tr>
              </thead>
              <tbody>
                {filasVeedores.map((a, i) => (
                  <tr>
                    <td class="g-num">{i + 1}</td>
                    <td>{title(a.recinto)}</td>
                    <td>{a.parroquia}</td>
                    <td class="g-num">
                      {a.sinVeedor} de {a.totalJuntas}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="g-informe-pie">
            {informe.accionesVeedores.length > filasVeedores.length
              ? `Se muestran los ${filasVeedores.length} primeros de ${informe.accionesVeedores.length} recintos; el resto está en el desglose y en el CSV.`
              : ""}
          </p>
        </>
      ) : null}
    </section>

    {veOperacion ? (
      <section aria-labelledby="inf-ritmo">
        <h2 id="inf-ritmo">Tiempo y ritmo</h2>
        {ritmo.cuenta.iniciada ? (
          <p class="g-informe-lead">Las elecciones ya iniciaron.</p>
        ) : (
          <p class="g-informe-lead">
            Para cubrir los {fmt(ritmo.puestosNecesarios)} puestos (juntas,
            recintos y recintos CDA) hay {fmt(ritmo.personasUnicas)} personas
            distintas registradas, en Militancia o ya asignadas. Faltan{" "}
            <strong>{fmt(ritmo.faltan)}</strong>. Quedan{" "}
            <strong>
              {ritmo.cuenta.dias} {ritmo.cuenta.dias === 1 ? "día" : "días"}
            </strong>{" "}
            para las elecciones (29 de noviembre de 2026
            {ritmo.faltan > 0
              ? ritmo.cuenta.esHoy
                ? `): hay que conseguirlas hoy.`
                : `): el ritmo necesario es de ${fmt(ritmo.cuenta.ritmoPorDia)} ${ritmo.cuenta.ritmoPorDia === 1 ? "persona" : "personas"} por día.`
              : "): todos los puestos tienen quién los cubra."}
          </p>
        )}
        {militancia.total > 0 ? (
          <p class="g-informe-lead">
            En Militancia hay <strong>{fmt(militancia.total)}</strong> personas
            sin asignar
            {militancia.conRecinto > 0
              ? `, ${fmt(militancia.conRecinto)} con recinto ya precargado`
              : ""}
            {militancia.incorrectos > 0
              ? ` y ${fmt(militancia.incorrectos)} con datos por corregir`
              : ""}
            .
          </p>
        ) : null}
      </section>
    ) : null}

    <section aria-labelledby="inf-notas">
      <h2 id="inf-notas">Notas</h2>
      <ul class="g-informe-notas">
        <li>
          <strong>Cobertura completa.</strong> Una junta cuenta como cubierta si
          tiene veedor titular y su recinto tiene coordinador titular. Es la
          misma medida de Cobertura, del mapa y del resumen.
        </li>
        <li>
          <strong>Porcentajes.</strong> % Cobertura = ingresados sobre
          requerido; % Faltante = lo que falta sobre requerido. Los totales se
          calculan con las cifras reales, no promediando porcentajes.
        </li>
        <li>
          <strong>Fuente y corte.</strong> Registros de veedores, coordinadores
          y acreditados CDA de la base de gestión, a la fecha y hora indicadas.
          El informe se recalcula cada vez que se abre.
        </li>
        <li>
          <strong>CSV.</strong> Una fila por recinto, con separador «;» y coma
          decimal, listo para abrir en Excel.
        </li>
      </ul>
    </section>
  </article>
</GestionLayout>
