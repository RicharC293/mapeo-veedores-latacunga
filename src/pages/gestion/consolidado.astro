---
import GestionLayout from "../../layouts/GestionLayout.astro";
import GestionConsolidado from "../../components/gestion/GestionConsolidado";
import { getMapData } from "../../lib/data";
import { listVeedores } from "../../lib/gestion/veedores";
import { listCoordinadores } from "../../lib/gestion/coordinadores";
import { listAcreditadosCda } from "../../lib/gestion/acreditadosCda";
import { listLideres } from "../../lib/gestion/lideres";
import { listValidaciones } from "../../lib/validacion/validaciones";
import { validacionesParaVista } from "../../lib/validacion/pantalla";
import { COSTO_POR_CONSULTA } from "../../lib/validacion/ecuadorApi";
import type { ValidacionCedula } from "../../lib/validacion/plan";
import { PAGINAS_GESTION, rutaPorDefecto } from "../../lib/auth/roles";

if (!PAGINAS_GESTION.consolidado.includes(Astro.locals.rol)) {
  return Astro.redirect(rutaPorDefecto(Astro.locals.rol));
}

const data = await getMapData();
const [veedores, coordinadores, acreditados, lideres] = await Promise.all([
  listVeedores(),
  listCoordinadores(),
  listAcreditadosCda(),
  listLideres(),
]);

// Verificación de identidad en el Registro Civil: todos ven el estado, la edad
// y el género; solo el administrador sincroniza y decide los nombres. Si la
// tabla aún no existe, el Consolidado se muestra igual, sin esos datos.
const puedeVerificar = PAGINAS_GESTION.validacion.includes(Astro.locals.rol);
async function cargarValidaciones(): Promise<ValidacionCedula[]> {
  try {
    return validacionesParaVista(await listValidaciones(), puedeVerificar);
  } catch {
    return [];
  }
}
const validaciones = await cargarValidaciones();
const hayClave = Boolean(import.meta.env.ECUADORAPI_KEY);
---

<GestionLayout title="Consolidado" activo="consolidado">
  <h1>Consolidado</h1>
  <p class="g-sub">
    Todo lo cubierto en cada recinto en un solo lugar: coordinador, acreditado
    CDA y veedores de cada junta, con sus suplentes. Desde aquí mismo puedes
    mover a una persona de junta, recinto o responsabilidad, o desvincularla.
  </p>
  <GestionConsolidado
    client:load
    parroquias={data.parroquias.features.map(({ properties }) => ({
      properties,
    }))}
    recintos={data.recintos}
    lideres={lideres.map(({ id, nombres }) => ({ id, nombres }))}
    veedores={veedores}
    coordinadores={coordinadores}
    acreditados={acreditados}
    validaciones={validaciones}
    puedeVerificar={puedeVerificar}
    hayClave={hayClave}
    costoPorConsulta={COSTO_POR_CONSULTA}
  />
</GestionLayout>
