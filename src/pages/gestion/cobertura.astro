---
import GestionLayout from "../../layouts/GestionLayout.astro";
import CoberturaTable from "../../components/gestion/CoberturaTable";
import TableroCobertura from "../../components/gestion/TableroCobertura";
import { getMapData } from "../../lib/data";
import { listVeedores } from "../../lib/gestion/veedores";
import { listCoordinadores } from "../../lib/gestion/coordinadores";
import { listAcreditadosCda } from "../../lib/gestion/acreditadosCda";
import { listLideres } from "../../lib/gestion/lideres";
import { calcularCobertura } from "../../lib/gestion/coverage";
import { cifrasPorRecinto } from "../../lib/gestion/informe";
import { title as titleCase } from "../../lib/format";
import { PAGINAS_GESTION, rutaPorDefecto } from "../../lib/auth/roles";

if (!PAGINAS_GESTION.cobertura.includes(Astro.locals.rol)) {
  return Astro.redirect(rutaPorDefecto(Astro.locals.rol));
}

const data = await getMapData();
const veedores = await listVeedores();
const coordinadores = await listCoordinadores();
const acreditadosCda = await listAcreditadosCda();
const lideres = await listLideres();
const cobertura = calcularCobertura(
  data.recintos,
  veedores,
  coordinadores,
  acreditadosCda,
);

const parByCode = new Map(
  data.parroquias.features.map((f) => [f.properties.code, f]),
);
const recintoByCode = new Map(data.recintos.map((r) => [r.cod, r]));

const filas = cobertura.map((c) => ({
  recintoCodigo: c.recintoCodigo,
  parroquiaCodigo: c.parroquiaCodigo,
  nombreRecinto: titleCase(recintoByCode.get(c.recintoCodigo)?.nombre ?? ""),
  nombreParroquia: parByCode.get(c.parroquiaCodigo)?.properties.name ?? "",
  urbana: parByCode.get(c.parroquiaCodigo)?.properties.urbana ?? false,
  tieneCoordinadorTitular: c.tieneCoordinadorTitular,
  juntasCubiertas: c.juntasCubiertas,
  juntasCubiertasVerificado: c.juntasCubiertasVerificado,
  totalJuntas: c.totalJuntas,
  pct: c.pct,
  pctVerificado: c.pctVerificado,
}));

// Cifras por recinto (veedores, coordinador, CDA y cobertura completa) para los
// gráficos: los filtros y los modos se calculan en el navegador sobre estas
// filas, con el mismo cálculo del Informe.
const tablero = cifrasPorRecinto({
  recintos: data.recintos,
  parroquias: data.parroquias.features.map(({ properties }) => ({
    properties,
  })),
  veedores,
  coordinadores,
  acreditados: acreditadosCda,
});
const personaTablero = (p: {
  recintoCodigo: number;
  responsableLiderId: string | null;
  verificado: boolean;
}) => ({
  recintoCodigo: p.recintoCodigo,
  responsableLiderId: p.responsableLiderId,
  verificado: p.verificado,
});

const parroquiasOpciones = data.parroquias.features.map((f) => ({
  code: f.properties.code,
  name: f.properties.name,
  urbana: f.properties.urbana,
}));
---

<GestionLayout title="Cobertura" activo="cobertura">
  <h1>Cobertura de veedores y coordinadores</h1>
  <p class="g-sub">
    Cada gráfico mide un rol por separado contra los puestos que se necesitan:
    una junta por veedor, un recinto por coordinador y un recinto CDA por
    acreditado. El General mide la cobertura completa: una junta cuenta si tiene
    veedor titular y su recinto tiene coordinador titular, la misma medida del
    mapa y del resumen. Para una versión lista para imprimir, abre el{" "}
    <a href="/gestion/informe">Informe</a>; para ver la evolución día a día,
    revisa <a href="/gestion/crecimiento">Crecimiento</a>.
  </p>

  <TableroCobertura
    client:load
    filas={tablero}
    parroquias={parroquiasOpciones}
    lideres={lideres}
    veedores={veedores.map(personaTablero)}
    coordinadores={coordinadores.map(personaTablero)}
    acreditados={acreditadosCda.map(personaTablero)}
  />

  <h2>Detalle por recinto</h2>
  <CoberturaTable client:load filas={filas} parroquias={parroquiasOpciones} />
</GestionLayout>
