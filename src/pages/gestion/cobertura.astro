---
import GestionLayout from "../../layouts/GestionLayout.astro";
import { getMapData } from "../../lib/data";
import { listVeedores } from "../../lib/gestion/veedores";
import { listCoordinadores } from "../../lib/gestion/coordinadores";
import { calcularCobertura } from "../../lib/gestion/coverage";
import { title as titleCase, fmt } from "../../lib/format";

const data = await getMapData();
const veedores = await listVeedores();
const coordinadores = await listCoordinadores();
const cobertura = calcularCobertura(data.recintos, veedores, coordinadores);

const parByCode = new Map(
  data.parroquias.features.map((f) => [f.properties.code, f]),
);
const recintoByCode = new Map(data.recintos.map((r) => [r.cod, r]));

const filas = cobertura
  .map((c) => ({
    ...c,
    nombreRecinto: titleCase(recintoByCode.get(c.recintoCodigo)?.nombre ?? ""),
    nombreParroquia: parByCode.get(c.parroquiaCodigo)?.properties.name ?? "",
  }))
  .sort((a, b) => a.pct - b.pct);

const totalJuntas = cobertura.reduce((a, c) => a + c.totalJuntas, 0);
const totalCubiertas = cobertura.reduce((a, c) => a + c.juntasCubiertas, 0);
const pctGlobal =
  totalJuntas > 0 ? Math.round((totalCubiertas / totalJuntas) * 1000) / 10 : 0;

function colorFor(pct: number): string {
  const hue = Math.round((pct / 100) * 120);
  return `hsl(${hue}, 65%, 45%)`;
}
---

<GestionLayout title="Cobertura" activo="cobertura">
  <h1>Cobertura de veedores y coordinadores</h1>
  <p class="g-sub">
    Una junta cuenta como cubierta solo si tiene veedor titular y su recinto
    tiene coordinador titular.
  </p>

  <div class="g-summary">
    <div class="g-summary-item">
      <b>
        {fmt(totalCubiertas)} / {fmt(totalJuntas)}
      </b>
      <small>juntas cubiertas</small>
    </div>
    <div class="g-summary-item">
      <b>{pctGlobal}%</b>
      <small>cobertura del cantón</small>
    </div>
  </div>

  <table class="g-table">
    <thead>
      <tr>
        <th>Parroquia</th>
        <th>Recinto</th>
        <th>Coordinador</th>
        <th>Juntas cubiertas</th>
        <th>% cobertura</th>
      </tr>
    </thead>
    <tbody>
      {filas.map((f) => (
        <tr>
          <td>{f.nombreParroquia}</td>
          <td>{f.nombreRecinto}</td>
          <td>{f.tieneCoordinadorTitular ? "Sí" : "No"}</td>
          <td>
            {f.juntasCubiertas} / {f.totalJuntas}
          </td>
          <td>
            <div class="g-bar">
              <span style={`width:${f.pct}%; background:${colorFor(f.pct)}`} />
            </div>
            {f.pct}%
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</GestionLayout>
