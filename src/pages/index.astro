---
import Base from "../layouts/Base.astro";
import MapApp from "../components/MapApp";
import { getMapData } from "../lib/data";
import { listLideres } from "../lib/gestion/lideres";
import { listCoordinadores } from "../lib/gestion/coordinadores";
import { listVeedores } from "../lib/gestion/veedores";

const [data, lideres, coordinadores, veedores] = await Promise.all([
  getMapData(),
  listLideres(),
  listCoordinadores(),
  listVeedores(),
]);
---

<Base title="Recintos electorales de Latacunga" bodyClass="map-page">
  <div class="app">
    <MapApp
      client:load
      data={data}
      lideres={lideres}
      coordinadores={coordinadores}
      veedores={veedores}
    />
  </div>
</Base>
