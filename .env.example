# Obtén estas claves en el dashboard de Supabase, en Settings > API Keys
# (NO en la pestaña "API" vieja: esa muestra las claves legadas anon/service_role,
# que Supabase va a eliminar a fines de 2026).

# URL del proyecto y clave publishable (empieza con "sb_publishable_"). Son
# públicas: se envían al navegador, protegidas por las políticas RLS de las
# migraciones. Reemplaza a la clave "anon" legada.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secret (empieza con "sb_secret_"). Secreta: solo la usan
# scripts/seed-supabase.ts y el propio servidor de Astro (rutas API de
# /gestion). Reemplaza a la clave "service_role" legada. Nunca con prefijo
# PUBLIC_, nunca en el navegador, nunca en un commit.
SUPABASE_SECRET_KEY=

# Solo se usan una vez, al correr `pnpm create-admin` para crear la cuenta
# de administrador en Supabase Auth. Bórralas de tu .env después de correrlo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
